# Variables of the Portainer stack (Stacks -> healthmap -> Environment variables). Never commit the real values.

# GitHub fine-grained token, read-only "Contents" on cmtprooptiki/hcp-registry-backend and hcp-frontend-map
GITHUB_TOKEN=github_pat_xxx
GIT_BRANCH=main

# Public addresses (the Nginx Proxy Manager hosts, with SSL)
APP_URL=https://app.healthiq-registry.gr
API_URL=https://api.healthiq-registry.gr

# Database
DB_NAME=hcp_registry
DB_USER=hcp
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Long random string for the login sessions (e.g. openssl rand -hex 32)
SESS_SECRET=change-me
API_KEY=

# Ports on the server (Nginx Proxy Manager forwards to them)
FRONTEND_PORT=3010
BACKEND_PORT=5010
